# ---------- Option 2: Main Auto-Login (Original Working Logic) ----------
def open_browser_with_main_cookies():
    """🦊 बिल्कुल वैसा ही जैसा Working Code में है – original open_browser_with_cookies"""
    print("🦊 Firefox खोल रहा हूँ (Original Main Logic)...")
    options = FirefoxOptions()
    options.set_preference("security.mixed_content.block_active_content", False)
    options.set_preference("security.mixed_content.block_display_content", False)
    options.set_preference("dom.security.https_only_mode", False)
    options.set_preference("dom.security.https_only_mode_ever_enabled", False)
    try:
        with open(USER_AGENT_FILE, "r") as f:
            ua = f.read().strip()
        if ua:
            options.set_preference("general.useragent.override", ua)
    except:
        pass
    try:
        profile = FirefoxProfile(PROFILE_PATH)
        options.profile = profile
    except Exception as e:
        print(f"⚠️ Profile Load Error: {e}")

    driver = webdriver.Firefox(service=Service(GeckoDriverManager().install()), options=options)
    driver.maximize_window()
    driver.get(MAIN_LOGIN_URL)
    time.sleep(2)
    driver.delete_all_cookies()
    print("🗑️ पुरानी Cookies Delete कर दी गईं।")

    # ---------- 🔥 Original Injection (बिल्कुल Working Code जैसा) ----------
    try:
        with open(MAIN_COOKIE_FILE, "rb") as f:
            data = pickle.load(f)
        cookies = data.get('cookies', [])
        local_storage = data.get('localStorage', {})
        session_storage = data.get('sessionStorage', {})

        for cookie in cookies:
            clean_cookie = {}
            clean_cookie['name'] = cookie['name']
            clean_cookie['value'] = cookie['value']
            clean_cookie['domain'] = cookie.get('domain', 'jharnibandhan.gov.in')
            clean_cookie['path'] = cookie.get('path', '/')
            if cookie.get('secure', False):
                clean_cookie['secure'] = True
            if cookie.get('httpOnly', False):
                clean_cookie['httpOnly'] = True
            if cookie.get('sameSite'):
                clean_cookie['sameSite'] = cookie['sameSite'].lower()
            else:
                clean_cookie['sameSite'] = 'no_restriction'
            if 'expirationDate' in cookie and cookie['expirationDate']:
                clean_cookie['expiry'] = int(cookie['expirationDate'])
            elif 'expiry' in cookie and cookie['expiry']:
                clean_cookie['expiry'] = int(cookie['expiry'])
            try:
                driver.add_cookie(clean_cookie)
                print(f"✅ Cookie Added: {clean_cookie['name']}")
            except Exception as e:
                print(f"⚠️ कुकी Add नहीं हुई ({clean_cookie.get('name')}): {e}")
                if 'sameSite' in clean_cookie:
                    del clean_cookie['sameSite']
                    try:
                        driver.add_cookie(clean_cookie)
                        print(f"✅ Cookie Added (Fallback): {clean_cookie['name']}")
                    except Exception as e2:
                        print(f"❌ Fallback भी Fail: {e2}")

        print(f"✅ {len(cookies)} कुकीज़ Selenium से Inject हुईं।")
        if local_storage:
            for key, val in local_storage.items():
                driver.execute_script(f"localStorage.setItem('{key}', '{val}');")
        if session_storage:
            for key, val in session_storage.items():
                driver.execute_script(f"sessionStorage.setItem('{key}', '{val}');")
    except FileNotFoundError:
        print("❌ डेटा नहीं मिला। पहले Option 3 से Fresh Login करें।")
        driver.quit()
        return None

    driver.get(MAIN_DASHBOARD_URL)
    time.sleep(4)
    current_url = driver.current_url
    print(f"📍 Current URL: {current_url}")
    if "citizenlogin" in current_url:
        print("⚠️ Session expired. Run Option 3 to refresh.")
        driver.quit()
        return None
    elif "/welcome" in current_url or "welcome" in current_url:
        print("🎉 Main Auto-Login successful!")
        return driver
    else:
        print(f"⚠️ Unexpected URL: {current_url}")
        driver.quit()
        return None

# ---------- Helper functions ----------
def click_pay_now_button(driver):
    selectors = [
        "//button[contains(text(),'Pay Now')]",
        "//input[@value='Pay Now']",
        "//button[@id='payNow']",
        "//*[@id='payNow']",
        "//input[@type='submit' and @value='Pay Now']",
    ]
    for sel in selectors:
        try:
            el = WebDriverWait(driver, 5).until(EC.element_to_be_clickable((By.XPATH, sel)))
            el.click()
            print(f"✅ Pay Now clicked: {sel}")
            return True
        except:
            continue
    print("❌ Pay Now not found.")
    return False

def tick_checkboxes(driver):
    try:
        driver.execute_script("""
            var cb = document.getElementById('chkterms');
            if (cb) { cb.checked = true; cb.dispatchEvent(new Event('change', {bubbles: true})); }
            var cb2 = document.getElementById('takenBefore');
            if (cb2) { cb2.checked = true; cb2.dispatchEvent(new Event('change', {bubbles: true})); }
        """)
        return True
    except:
        return False

def handle_mandate_page(driver):
    try:
        WebDriverWait(driver, 15).until(EC.presence_of_element_located((By.ID, "chkterms")))
        print("✅ Mandate page loaded.")
        if not tick_checkboxes(driver):
            return False
        try:
            modal = WebDriverWait(driver, 5).until(EC.visibility_of_element_located((By.ID, "myModal")))
            btns = modal.find_elements(By.CSS_SELECTOR, "button, input[type='submit']")
            for btn in btns:
                if btn.is_displayed() and btn.is_enabled():
                    if btn.text.strip() or btn.get_attribute("value"):
                        btn.click()
                        print(f"✅ Clicked: {btn.text.strip() or btn.get_attribute('value')}")
                        break
            WebDriverWait(driver, 10).until(EC.invisibility_of_element_located((By.ID, "myModal")))
        except:
            driver.execute_script("document.getElementById('form1').submit();")
        time.sleep(2)
        WebDriverWait(driver, 15).until(EC.presence_of_element_located((By.ID, "txtLoginId")))
        print("✅ Login page reached.")
        return True
    except:
        print("⚠️ Mandate handling failed or already passed.")
        return "DepartmentLogin" in driver.current_url

