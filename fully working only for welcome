if __name__ == "__main__":
    print("🚀 Jharkhand Session Manager")
    print("1️⃣  Status Check (बिना Browser)")
    print("2️⃣  Browser खोलें → Auto-Login (पुरानी Cookies Clear + Inject)")
    print("3️⃣  Fresh Login – मैन्युअल करो, सारी Cookies सेव करो")
    choice = input("👉 चुनाव (1/2/3): ")

    if choice == "1":
        if login_without_browser():
            print("✅ Session Valid है।")
        else:
            print("❌ Session Expired है।")
    elif choice == "2":
        open_browser_with_cookies()
    elif choice == "3":
        fresh_login_manual()
    else:
        print("❌ गलत चुनाव।")
