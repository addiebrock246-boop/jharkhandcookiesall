# ==========================================
LOGIN_URL = "https://jharnibandhan.gov.in/Citizenentry/citizenlogin"
DASHBOARD_URL = "https://jharnibandhan.gov.in/Citizenentry/welcome"
COOKIE_FILE = "session_data.pkl"
USER_AGENT_FILE = "user_agent.txt"
PROFILE_PATH = r"C:\Users\admin\AppData\Roaming\Mozilla\Firefox\Profiles\tz38mt81.default-release"


# ==========================================

def login_without_browser():
    try:
        with open(COOKIE_FILE, "rb") as f:
            data = pickle.load(f)
        cookies = data.get('cookies', [])
        session = requests.Session()
        for c in cookies:
            session.cookies.set(c['name'], c['value'], domain=c.get('domain', 'jharnibandhan.gov.in'))
        resp = session.get(DASHBOARD_URL, allow_redirects=True)
        if "citizenlogin" in resp.url:
            print("⚠️ कुकीज़ Expired हैं।")
            return False
        else:
            print("✅ बिना ब्राउज़र के अंदर घुस गया!")
            return True
    except FileNotFoundError:
        print("📁 डेटा नहीं मिला।")
        return False


def open_browser_with_cookies():
    """🦊 Firefox खोलो, पुरानी Cookies हटाओ, फिर नई Inject करो"""
    print("🦊 Firefox खोल रहा हूँ (पुरानी Cookies Clear करूँगा)...")
    options = FirefoxOptions()

    # Mixed Content Blocking हटाओ (HTTP Redirect Allow)
    options.set_preference("security.mixed_content.block_active_content", False)
    options.set_preference("security.mixed_content.block_display_content", False)
    options.set_preference("dom.security.https_only_mode", False)
    options.set_preference("dom.security.https_only_mode_ever_enabled", False)

    # User-Agent Set करें
    try:
        with open(USER_AGENT_FILE, "r") as f:
            ua = f.read().strip()
        if ua:
            options.set_preference("general.useragent.override", ua)
    except:
        pass

    # Profile Load करें
    try:
        profile = FirefoxProfile(PROFILE_PATH)
        options.profile = profile
    except Exception as e:
        print(f"⚠️ Profile Load Error: {e}")

    driver = webdriver.Firefox(service=Service(GeckoDriverManager().install()), options=options)
    driver.maximize_window()
    driver.get(LOGIN_URL)
    time.sleep(2)

    # 🔥🔥🔥 सबसे ज़रूरी लाइन – पुरानी सारी Cookies हटाओ
    driver.delete_all_cookies()
    print("🗑️ पुरानी Cookies Delete कर दी गईं।")

    # ---------- 🔥 Cookies Inject (Cookie Editor Style) ----------
    try:
        with open(COOKIE_FILE, "rb") as f:
            data = pickle.load(f)
        cookies = data.get('cookies', [])
        local_storage = data.get('localStorage', {})
        session_storage = data.get('sessionStorage', {})

        # 1. Cookies Add करें (बिल्कुल Cookie Editor की तरह)
        for cookie in cookies:
            clean_cookie = {}
            clean_cookie['name'] = cookie['name']
            clean_cookie['value'] = cookie['value']
            clean_cookie['domain'] = cookie.get('domain', 'jharnibandhan.gov.in')
            clean_cookie['path'] = cookie.get('path', '/')

            if cookie.get('secure', False):
                clean_cookie['secure'] = True
            if cookie.get('httpOnly', False):
                clean_cookie['httpOnly'] = True

            if cookie.get('sameSite'):
                clean_cookie['sameSite'] = cookie['sameSite'].lower()
            else:
                clean_cookie['sameSite'] = 'no_restriction'

            if 'expirationDate' in cookie and cookie['expirationDate']:
                clean_cookie['expiry'] = int(cookie['expirationDate'])
            elif 'expiry' in cookie and cookie['expiry']:
                clean_cookie['expiry'] = int(cookie['expiry'])

            try:
                driver.add_cookie(clean_cookie)
                print(f"✅ Cookie Added: {clean_cookie['name']}")
            except Exception as e:
                print(f"⚠️ कुकी Add नहीं हुई ({clean_cookie.get('name')}): {e}")
                # Fallback: बिना sameSite के Try करें
                if 'sameSite' in clean_cookie:
                    del clean_cookie['sameSite']
                    try:
                        driver.add_cookie(clean_cookie)
                        print(f"✅ Cookie Added (Fallback): {clean_cookie['name']}")
                    except Exception as e2:
                        print(f"❌ Fallback भी Fail: {e2}")

        print(f"✅ {len(cookies)} कुकीज़ Selenium से Inject हुईं।")

        # 2. LocalStorage Inject करें
        if local_storage:
            for key, val in local_storage.items():
                driver.execute_script(f"localStorage.setItem('{key}', '{val}');")
            print(f"✅ {len(local_storage)} localStorage आइटम्स Inject किए।")

        if session_storage:
            for key, val in session_storage.items():
                driver.execute_script(f"sessionStorage.setItem('{key}', '{val}');")
            print(f"✅ {len(session_storage)} sessionStorage आइटम्स Inject किए।")

    except FileNotFoundError:
        print("❌ डेटा नहीं मिला। पहले Option 3 से Fresh Login करें।")
        driver.quit()
        return

    # ---------- 🚀 Dashboard पर Navigate करें ----------
    print("🚀 अब Dashboard (/welcome) पर जा रहा हूँ...")
    driver.get(DASHBOARD_URL)
    time.sleep(4)

    current_url = driver.current_url
    print(f"📍 Current URL: {current_url}")

    if "citizenlogin" in current_url:
        print("⚠️ सेशन Expired। Fresh Login करें।")
        driver.quit()
        fresh_login_manual()
    elif "/welcome" in current_url or "welcome" in current_url:
        print("🎉 Auto-Login सफल! अब तुम Welcome Dashboard पर हो!")
        print("📌 ब्राउज़र खुला रहेगा – बंद करने के लिए Enter दबाएँ।")
        input()
        driver.quit()
    else:
        print(f"⚠️ अजीब URL: {current_url}")
        print("👉 F12 Console में `window.location.href` चेक करें।")
        input("⏳ Enter दबाएँ ब्राउज़र बंद करने के लिए...")
        driver.quit()


def fresh_login_manual():
    """🔥 मैन्युअल Login – सारी Cookie Properties सेव करें (Cookie Editor Style)"""
    print("🔄 Fresh Login शुरू... (सारे Firefox बंद रखें)")
    options = FirefoxOptions()
    try:
        profile = FirefoxProfile(PROFILE_PATH)
        options.profile = profile
    except Exception as e:
        print(f"⚠️ Profile Load नहीं हुआ: {e}")

    driver = webdriver.Firefox(service=Service(GeckoDriverManager().install()), options=options)
    driver.maximize_window()
    driver.get(LOGIN_URL)

    print("\n⏳ अब **तुम मैन्युअली Login करो** – CAPTCHA, OTP भरो।")
    print(f"👉 **ध्यान दें**: Login करने के बाद URL **{DASHBOARD_URL}** होना चाहिए।")
    print("✅ **जब URL /welcome पर हो**, तो इस Terminal पर आकर **Enter** दबाओ।\n")

    input("⏳ Enter दबाओ जब सही Dashboard पर हो...")

    current_url = driver.current_url
    print(f"👉 Final URL: {current_url}")

    # User-Agent सेव करें
    ua = driver.execute_script("return navigator.userAgent;")
    with open(USER_AGENT_FILE, "w") as f:
        f.write(ua)

    # ---------- 🔥 Cookies को Cookie Editor Style में सेव करें ----------
    cookies = driver.get_cookies()
    clean_cookies = []
    for c in cookies:
        clean = {
            'name': c['name'],
            'value': c['value'],
            'domain': c.get('domain', 'jharnibandhan.gov.in'),
            'path': c.get('path', '/'),
            'secure': c.get('secure', False),
            'httpOnly': c.get('httpOnly', False),
            'sameSite': c.get('sameSite', 'no_restriction'),
        }
        if 'expiry' in c and c['expiry']:
            clean['expirationDate'] = float(c['expiry'])
        clean_cookies.append(clean)

    local_storage = driver.execute_script("return {...localStorage};")
    session_storage = driver.execute_script("return {...sessionStorage};")

    data = {
        'cookies': clean_cookies,
        'localStorage': local_storage,
        'sessionStorage': session_storage
    }

    with open(COOKIE_FILE, "wb") as f:
        pickle.dump(data, f)

    print(f"✅ {len(clean_cookies)} कुकीज़ (Secure, HttpOnly, sameSite समेत) सेव हो गईं।")
    print(f"✅ {len(local_storage)} localStorage, {len(session_storage)} sessionStorage सेव हो गए।")
    print("🎉 अब 'Option 2' चलाओ – बिना OTP के अंदर घुस जाओगे!")

    driver.quit()


