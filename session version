# 📊 STATUS CHECK
# ============================================================
def status_check():
    print("\n📊 STATUS CHECK")
    
    # Check JSON file
    try:
        if os.path.exists(JSON_COOKIE_FILE):
            with open(JSON_COOKIE_FILE, "r") as f:
                cookies = json.load(f)
            phpsessid = None
            for c in cookies:
                if c['name'] == 'PHPSESSID':
                    phpsessid = c
                    break
            if phpsessid and 'expirationDate' in phpsessid:
                remaining = (phpsessid['expirationDate'] - time.time()) / (60 * 60 * 24)
                if remaining > 0:
                    print(f"✅ JSON Cookie Session VALID – {remaining:.0f} days remaining")
                else:
                    print("⚠️ JSON Cookie Session EXPIRED")
            else:
                print("ℹ️ PHPSESSID not found in JSON")
        else:
            print("❌ No cookies.json file found.")
    except Exception as e:
        print(f"⚠️ Error reading JSON: {e}")
    
    # Check old session file
    try:
        with open(SESSION_FILE, "rb") as f:
            session = pickle.load(f)
        remaining = (session.get('expiry', 0) - time.time()) / (60 * 60 * 24)
        if remaining > 0:
            print(f"✅ Session File Valid – {remaining:.0f} days remaining")
        else:
            print("⚠️ Session File EXPIRED")
    except:
        print("❌ No session file found.")

