# ============================================================
# 🔥 HELPER: Clean Cookie (Selenium के लिए)
# ============================================================
def prepare_cookie(cookie):
    clean = {
        'name': cookie['name'],
        'value': cookie['value'],
        'domain': cookie.get('domain', 'jharnibandhan.gov.in'),
        'path': cookie.get('path', '/'),
        'secure': cookie.get('secure', True),
        'httpOnly': cookie.get('httpOnly', True),
        'sameSite': cookie.get('sameSite', 'Lax')
    }
    # Expiry को int में बदलो
    if 'expirationDate' in cookie:
        clean['expiry'] = int(cookie['expirationDate'])
    elif 'expiry' in cookie:
        clean['expiry'] = int(cookie['expiry'])
    else:
        clean['expiry'] = int(time.time()) + 15778463  # 6 महीने
    return clean

