            cookies = json.loads(COOKIES_JSON)
            print(f"✅ Loaded {len(cookies)} cookies from embedded JSON")
    except Exception as e:
        print(f"❌ Error loading JSON: {e}")
        return
    
    driver = get_driver()
    
    # Login Page पर जाओ
    driver.get(LOGIN_URL)
    time.sleep(2)
